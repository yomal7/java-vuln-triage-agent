# --- API key (free tier: https://aistudio.google.com/apikey) -------------------
GOOGLE_API_KEY=

# --- Model chain: first = preferred, the rest are fallbacks, in order ----------
# Run `python agent/list_models.py` to see which model names your key can use.
# Example (replace with real names from that list):
# LLM_MODELS=gemini-3.7-flash,gemini-3.8-flash,gemini-3.5-flash-lite
LLM_MODELS=gemini-3.5-flash-lite

# --- Provider (switch here when moving to a paid API or another vendor) --------
# google (default) | openai | anthropic | ...  (non-google needs its package,
# e.g. `uv add langchain-openai`, plus that provider's key such as OPENAI_API_KEY)
LLM_PROVIDER=google

# --- Reliability ---------------------------------------------------------------
# Max model calls per minute across all threads. Raise on a paid plan.
LLM_RPM=10
# Retries per model on transient errors (408, 429, 5xx, timeouts) before
# falling back to the next model. Waits grow 2s, 4s, 8s ... (cap 60s, +-25% jitter).
LLM_MAX_RETRIES=3
# LLM_BACKOFF_INITIAL=2
# LLM_BACKOFF_FACTOR=2
# LLM_BACKOFF_MAX=60
# LLM_TIMEOUT=60
# 0 = most repeatable runs (recommended for the experiments)
# LLM_TEMPERATURE=0

# How many alerts are triaged at the same time (see agent/run_triage.py)
# TRIAGE_CONCURRENCY=2

# Optional: only if you deliberately route through a gateway/proxy
# LLM_BASE_URL=
